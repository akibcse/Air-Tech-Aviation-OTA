{
    "version": 2,
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "airtechaviation.click"
                }
            ],
            "destination": "https://airtech-aviation-ota.vercel.app/$1",
            "permanent": true
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "airtech-angular.vercel.app"
                }
            ],
            "destination": "https://airtech-aviation-ota.vercel.app/$1",
            "permanent": true
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "www.airtechaviation.click"
                }
            ],
            "destination": "https://airtech-aviation-ota.vercel.app/$1",
            "permanent": true
        }
    ],
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "airtech-angular/dist/airtech-angular/browser"
            }
        },
        {
            "src": "api/index.js",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}