rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if requesting user is an Admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'roadyakib@gmail.com' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN');
    }

    // Users Collection: ONLY Admin can read/write user data. Users can only access their own profile.
    match /users/{userId} {
      allow create: if request.auth != null;
      allow read, write: if isAdmin();
      allow read, update: if request.auth != null && request.auth.uid == userId;
    }

    // Visitor Leads: Public create (for silent lead tracking), ONLY Admin can read and write/delete
    match /visitor_leads/{leadId} {
      allow create: if true;
      allow read, write, delete: if isAdmin();
    }

    // Bookings: Admin can read/write all, Users can access their own
    match /bookings/{bookingId} {
      allow read, write: if isAdmin();
      allow create: if request.auth != null;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Settings: Public read, ONLY Admin write
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
